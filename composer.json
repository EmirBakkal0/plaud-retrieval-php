{
    "name": "plaud/plaud-php",
    "description": "Unofficial framework-agnostic PHP SDK for retrieving transcripts, recordings, and audio from Plaud.ai",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "plaud",
        "plaud-ai",
        "transcript",
        "audio",
        "recording",
        "sdk",
        "api-client"
    ],
    "authors": [
        {
            "name": "Iceberg X Team Alpha",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Allows using Guzzle as the underlying HTTP client (>=7.0)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Plaud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plaud\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}